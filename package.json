{
  "name": "cs2-profile-studio",
  "version": "3.1.0",
  "description": "Capture, edit, export and restore your own CS2 settings offline",
  "author": "SpiRaL",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tools/smoke-ui.cjs",
    "dist": "electron-builder --win zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "network.spiral.cs2profilestudio",
    "productName": "CS2 Profile Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "studio/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "icon": "desktop/icon.ico"
    },
    "artifactName": "CS2-Profile-Studio-${version}-windows-x64.${ext}"
  }
}
